7.remove character from first string present in second string

def removeCharacter(str1,str2):
    remove_set=set(str2)
    
    result=[]
    for ch in str1:
        if ch not in remove_set:   
            result.append(ch)
    return"".join(result)    creating the string by "" and joining the result 

str1=input().strip()
str2=input().strip()
print(removeCharacter(str1,str2))


