1.equilibrium index

def equilibrium_index(arr):
    total_sum = sum(arr)
    left_sum = 0

    for i in range(len(arr)):
        total_sum -= arr[i]

        if left_sum == total_sum:
            return i

        left_sum += arr[i]

    return -1

n = int(input())
arr = list(map(int, input().split()))
print(equilibrium_index(arr))


  
