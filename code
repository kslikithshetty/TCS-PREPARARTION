3.first and last accurance of the number
def first_number(arr,x):
    low,high=0,len(arr)-1
    ans=-1
    
    while low<=high:
        mid=(low+high)//2
    
        if arr[mid]==x:
           ans=mid
           high=mid-1
        elif arr[mid]<x:
            low =mid + 1
        else:
             high=mid -1
    return ans

def last_number(arr,x):
    low,high=0,len(arr)-1
    ans=-1
    
    while low<=high:
        mid=(low+high)//2
    
        if arr[mid]==x:
           ans=mid
           low=mid+1
        elif arr[mid]<x:
           low =mid + 1
        else:
             high=mid -1
    return ans
    
n=int(input())
x=int(input())
arr=list(map(int,input().split()))

print(first_number(arr,x),last_number(arr,x))
    
